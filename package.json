{
  "name": "@particlr/runtime",
  "version": "0.8.1",
  "description": "Framework-agnostic particle simulation core + Pixi v8/v7, Three.js, and Phaser 4 adapters for the .prt format.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://particlr.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brac/particlr-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/brac/particlr-runtime/issues"
  },
  "keywords": [
    "particles",
    "particle-system",
    "particle-effects",
    "vfx",
    "pixijs",
    "pixi",
    "game-development",
    "gamedev",
    "2d",
    "webgl",
    "webgpu",
    "animation",
    "three",
    "threejs",
    "phaser"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./textures": {
      "types": "./dist/textures.d.ts",
      "import": "./dist/textures.js"
    },
    "./pixi": {
      "types": "./dist/pixi/index.d.ts",
      "import": "./dist/pixi/index.js"
    },
    "./pixi7": {
      "types": "./dist/pixi7/index.d.ts",
      "import": "./dist/pixi7/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js"
    },
    "./phaser": {
      "types": "./dist/phaser/index.d.ts",
      "import": "./dist/phaser/index.js"
    },
    "./particle.schema.json": "./dist/particle.schema.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.pixi.json && tsc --noEmit -p tsconfig.pixi7.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.three.json && tsc --noEmit -p tsconfig.phaser.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build-pixi7.json && node scripts/copy-schema.mjs && tsc -p tsconfig.build-three.json && tsc -p tsconfig.build-phaser.json",
    "gen-schema": "tsx scripts/gen-schema.ts",
    "size": "node scripts/check-size.mjs",
    "size:three": "node scripts/check-size-three.mjs",
    "size:phaser": "node scripts/check-size-phaser.mjs"
  },
  "peerDependencies": {
    "pixi.js": ">=7.2.0 <9",
    "three": "^0.185.0 || ^0.186.0",
    "phaser": ">=4.2 <5"
  },
  "peerDependenciesMeta": {
    "pixi.js": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "phaser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/three": "0.186.0",
    "esbuild": "^0.24.2",
    "jsdom": "^26",
    "phaser": "4.2.1",
    "pixi.js": "8.22.0",
    "pixi7": "npm:pixi.js@7.4.3",
    "three": "0.186.1",
    "ts-json-schema-generator": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
